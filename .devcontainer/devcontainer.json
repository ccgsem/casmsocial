// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
    "name": "casmsocial",
    // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
    "dockerFile": "Dockerfile",
    "target": "dev",
    "features": {},

    // Use 'postCreateCommand' to run commands after the container is created.
    "postCreateCommand": "./.devcontainer/postCreateCommand.sh",

    // Configure tool-specific properties.
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "editorconfig.editorconfig",
                "ms-python.vscode-pylance",
                "ms-azuretools.vscode-docker"
            ],
            "settings": {
                "python.testing.pytestArgs": ["tests"],
                "python.testing.unittestEnabled": false,
                "python.testing.pytestEnabled": true,
                "python.defaultInterpreterPath": "/workspaces/casmsocial/.venv/bin/python",
                "python.testing.pytestPath": "/workspaces/casmsocial/.venv/bin/pytest",
                "python.analysis.extraPaths": ["${workspaceFolder}"],
                "python.linting.enabled": true,
                "python.linting.pylintEnabled": true
            }
        }
    },

    // Set environment variables
    "remoteEnv": {
        "PYTHONPATH": "${containerWorkspaceFolder}",
        "MPI_CXX_COMPILER": "mpicxx",
        "VIRTUAL_ENV": "/workspaces/casmsocial/.venv",
        "PATH": "/workspaces/casmsocial/.venv/bin:${containerEnv:PATH}"
    },

    // Configure container mounts
    "mounts": [
        "source=${localWorkspaceFolder},target=/workspaces/casmsocial,type=bind,consistency=cached"
    ],

    // Set the remote user
    "remoteUser": "vscode",

    // Add container features
    "features": {
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.12",
            "installTools": true
        },
        "ghcr.io/devcontainers/features/git:1": {}
    }
}
