# Copy this file to .env for local runs. The .env file is gitignored.

# --- Simulation data paths (required) ---
# For local runs use the self-contained MVP demo:
CASMSOCIAL_DATA_PATH="examples/mvp"
CASMSOCIAL_DUCKLAKE_PATH="examples/mvp/mvp.ducklake"

# For full-scale runs point at your DuckLake catalog:
# CASMSOCIAL_DATA_PATH="/path/to/data"
# CASMSOCIAL_DUCKLAKE_PATH="/path/to/catalog.ducklake"

# --- Additional model plugins ---
# Optional comma-separated Python modules to import so they can self-register
# model classes with the casmsocial factory (e.g. wake_county_heat_risk.heat_risk_model2).
CASMSOCIAL_MODELS=""

# --- Remote LLM behavior (optional) ---
# Required only when behavior.llm.adapter is set to "anthropic" in YAML config.
ANTHROPIC_API_KEY=""

# --- casmdb scenario registry (optional) ---
# Used by scripts/run_scenario.py. Local file path or s3://bucket/path/models.db.
CASMDB_PATH=""
